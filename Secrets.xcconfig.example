// Секретные ключи сборки. Скопируйте этот файл в Secrets.xcconfig (тот же
// каталог) и подставьте реальный ключ — Secrets.xcconfig в .gitignore и не
// попадает в репозиторий.
//
// SILERO_API_KEY — ключ доступа к продакшн-серверу Silero
// (https://tts.pdf-voice.com). Спросить у владельца проекта / посмотреть в
// silero-server/deploy (.env на сервере). Пустое значение допустимо: без
// сервера приложение штатно откатывается на системный голос.

SILERO_API_KEY =
